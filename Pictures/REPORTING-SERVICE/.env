# ===========================
# Variables para docker-compose
# ===========================

# Puerto host -> contenedor (contenedor siempre expone 8080)
HOST_PORT=8080
REPORTING_SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080

# Seguridad / JWT (se mapean a security.*)
SECURITY_SECRET=QnE1T2lXbVRhV3RzR2VOUXlHaFZ2d2dyU2p2a1R2TnM=
SECURITY_EXPIRATION_SEC=3600
SECURITY_ISSUER=autenticacion-service
SECURITY_ISSUER_URI=

# AWS Config
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Dynamo (app.dynamo.*)
APP_DYNAMO_TABLE=crediya-reports
APP_DYNAMO_GSI=metricId-updatedAt-index
APP_DYNAMO_PK=global-report

# SQS (entrypoint.sqs.*)
ENTRYPOINT_SQS_QUEUEURL=https://sqs.us-east-2.amazonaws.com/889522049804/generate-reports-queue
ENTRYPOINT_SQS_WAITTIMESECONDS=20
ENTRYPOINT_SQS_MAXNUMBEROFMESSAGES=10
ENTRYPOINT_SQS_VISIBILITYTIMEOUTSECONDS=10
ENTRYPOINT_SQS_NUMBEROFTHREADS=1

# Enlaces internos entre servicios (si levantas IAM en la misma red)
ADAPTER_RESTCONSUMER_URL=http://iam-service:8080

# JVM tuning
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
